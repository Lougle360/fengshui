          "anchor_preview": "![](assets/book018/doc009/f7d5f56185b1c89f1e34d950ac15dad42b411b31e5a8fb3b02be9cb26326bd08.jpg)",
          "asset": "D:\\壮五福\\风水项目\\Md\\精校版\\assets\\book018\\doc009\\source-page-0081.jpg",
          "asset_bytes": 564696,
          "asset_sha256": "8766da96d07f203980b582886828289fbc11fd4996c5c10602c2f94b18cf9061",
