        "language": "classical_chinese",
        "content_type": "verse",
        "action": "rewrite",
        "modern_text": "鹅公嘴，以及龟肩，嘴部来势硬处不堪安葬。气势来势直急时宜用饶借，法点龟肩借靠安葬。",
        "confidence": "high",
        "uncertainty": []
