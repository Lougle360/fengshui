        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "丙水从艮方流出，或者从兑方流出，或者从巽方流出，都是从阴入阳，都属于上吉。",
        "confidence": "high",
        "uncertainty": []
