        "language": "classical_chinese",
        "content_type": "verse",
        "action": "rewrite",
        "modern_text": "贪狼五鬼并高山，上入云霄势一般。龙虎斗争终发祸，两峰相对忌刀残。",
        "confidence": "high",
        "uncertainty": []
