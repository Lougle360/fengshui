        "uncertainty": []
      },
      {
        "id": "book018-b003051-p000-59dccbfb92",
        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "丙辛丁庚的水先流到穴，称为阴鼓先鸣。谢献能所作的《清化胡知府祖地记》写道：‘阳鼓未鸣阴鼓鸣，人口尚千丁。’说的就是辛水朝穴的情况。",
