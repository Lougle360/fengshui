      {
        "id": "book035-b002069-p000-d0c6c6cf91",
        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "安放棺木时，紧贴宝脉是首要原则；观察那条微微细小的脉气。",
        "confidence": "high",
        "uncertainty": []
