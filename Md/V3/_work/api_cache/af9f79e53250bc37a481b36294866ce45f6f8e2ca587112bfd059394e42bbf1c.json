        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "卜公说：“尊指无名，咫尺有云泥之异。”说的就是中指倒处，是掌心穴。",
        "confidence": "high",
        "uncertainty": []
