        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "春天大忌亥子位，夏月须在寅卯方，秋日休逢在巳本，冬时申酉不可装。",
        "confidence": "high",
        "uncertainty": []
      },
