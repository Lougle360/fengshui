        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "起栏不得犯空亡，犯着之时牛必亡。癸日不堪行起造，牛瘟必定两相妨。",
        "confidence": "high",
        "uncertainty": []
