        "language": "classical_chinese",
        "content_type": "quote",
        "action": "rewrite",
        "modern_text": "天尊地卑，乾坤定矣；卑高以陈，贵贱位矣；动静有常，刚柔断矣。",
        "term_notes": [],
        "confidence": "high",
