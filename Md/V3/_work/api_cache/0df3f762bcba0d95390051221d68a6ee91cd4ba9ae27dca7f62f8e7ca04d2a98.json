        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "八禄八刃而用八禄，忌八刃。即从子起壬初，支干就禄，是缝针，也是地纪。",
        "confidence": "high",
        "uncertainty": []
