        "uncertainty": []
      },
      {
        "id": "book019-b002229-p000-d04a8e92c2",
        "language": "classical_chinese",
        "content_type": "prose",
        "action": "rewrite",
        "modern_text": "也曾见过穴面前有“水”欺逼，顾恋祖山就不怕低小。",
