    {"term":"生气","plain_definition":"本书用来解释万物发生和山川融结的传统地气观念。","source_blocks":["P000001-B002","P000001-B004","P000006-B005"],"relations":{"leads_to":["行止","藏风","得水"]}},
    {"term":"乘气","plain_definition":"使安葬位置承接原书所谓生气；核心不只是找到气，而是落在它停止聚集的位置。","source_blocks":["P000001-B002","P000006-B007","P000007-B002"],"relations":{"depends_on":["止","穴"]}},
    {"term":"势","plain_definition":"从较远处观察山地连续来行的整体走势。","source_blocks":["P000006-B009","P000006-B011","P000022-B002"],"relations":{"contrasted_with":["形"],"precedes":["止","形"]}},
    {"term":"形","plain_definition":"在较近处观察地势已经收束成局的具体形态。","source_blocks":["P000006-B011","P000007-B002","P000022-B002"],"relations":{"depends_on":["势"],"leads_to":["穴"]}},
    {"term":"止","plain_definition":"山地由继续行走转为停驻、收束的状态，是本书判断能否聚气的关键。","source_blocks":["P000006-B005","P000006-B007","P000007-B002"],"relations":{"between":["势","穴"]}},
    {"term":"风水","plain_definition":"原书以气遇风会散、遇水会止来命名的形势关系。","source_blocks":["P000004-B003","P000004-B005","P000004-B007"],"relations":{"contains":["藏风","得水"]}},
    {"term":"藏风","plain_definition":"穴场四周有适当护卫，不让风直接吹散原书所谓生气。","source_blocks":["P000004-B003","P000004-B007","P000018-B001"],"relations":{"paired_with":["得水"]}},
    {"term":"得水","plain_definition":"水势在合适位置横拦、环抱或停聚；原书把它列在藏风之前。","source_blocks":["P000004-B003","P000004-B007","P000017-B009"],"relations":{"paired_with":["藏风"]}},
    {"term":"支","plain_definition":"较平缓、隐伏的地势支脉；其气被说成较沉。","source_blocks":["P000004-B001","P000008-B004","P000014-B015"],"relations":{"contrasted_with":["垄"]}},
    {"term":"垄","plain_definition":"较高起、明显的山脊走势；其气被说成较浮。","source_blocks":["P000004-B001","P000014-B015","P000015-B001"],"relations":{"contrasted_with":["支"]}},
    {"term":"穴","plain_definition":"传统上认为山水形势停止、收束并聚气的具体安葬位置。","source_blocks":["P000007-B002","P000009-B001","P000016-B008"],"relations":{"depends_on":["势","止","形"]}},
    {"term":"明堂","plain_definition":"穴前较开阔、并与前方水势和朝应相关的空间。","source_blocks":["P000013-B012","P000021-B002"],"relations":{"part_of":["穴场"]}},
    {"term":"玄武","plain_definition":"穴后所倚的来山或后方形势；垂头指其向穴俯伏有情。","source_blocks":["P000019-B008","P000020-B007"],"relations":{"paired_with":["朱雀"]}},
    {"term":"朱雀","plain_definition":"穴前的水势或朝应空间；翔舞指其回环、趋朝而不直去。","source_blocks":["P000019-B010","P000020-B009","P000020-B013"],"relations":{"paired_with":["玄武"]}},
    {"term":"青龙","plain_definition":"穴场左侧的护卫形势，原书要求蜿蜒、回抱。","source_blocks":["P000019-B012","P000020-B011"],"relations":{"paired_with":["白虎"]}},
    {"term":"白虎","plain_definition":"穴场右侧的护卫形势，原书要求驯俯而不蹲踞逼迫。","source_blocks":["P000019-B014","P000020-B003"],"relations":{"paired_with":["青龙"]}},
    {"term":"入首","plain_definition":"来龙进入结穴区域前的关键一段。","source_blocks":["P000010-B001"],"relations":{"precedes":["穴"]}},
    {"term":"五土四备","plain_definition":"旧注用来概括穴中土质、颜色等条件齐备的传统说法；不是独立于整体形势的现代检测标准。","source_blocks":["P000016-B006","P000026-B006"],"relations":{"supports":["穴场验证"]}},
    {"term":"土圭、玉尺","plain_definition":"卷末文字用土圭说测方位、用玉尺说量远近；本版旧注又把玉尺解释为目力准绳。","source_blocks":["P000025-B006","P000026-B001"],"relations":{"limited_by":["势形优先"]}},
