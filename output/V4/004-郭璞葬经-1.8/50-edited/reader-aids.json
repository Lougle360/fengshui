      {
        "term": "生气",
        "plain_definition": "地中能使万物发生的气。",
        "contextual_definition": "本书把它作为山川融结、安葬取用的总纲。",
        "tier": "core",
        "confidence": "qualified",
        "aliases": [
          "生氣"
        ],
        "first_occurrence": {
          "block_id": "P000001-B002",
          "page_id": "P000001",
          "source_page": 1,
          "quote": "葬者乘生氣也"
        },
        "usage_example": "例：“气乘风则散，界水则止”说的是生气会被风吹散，又会被水势截住。",
        "related_terms": [
          "龙",
          "势"
        ],
        "common_confusions": "易混：这里的“气”是本书解释山川与安葬的传统概念，不是现代科学中的气体或能量。"
      },
      {
        "term": "乘气",
        "plain_definition": "让葬处承接生气。",
        "contextual_definition": "既包括寻找气的停聚处，也包括穴位深浅左右的配合。",
        "tier": "supporting",
        "confidence": "qualified",
        "aliases": [
          "乘生氣"
        ],
        "first_occurrence": {
          "block_id": "P000001-B002",
          "page_id": "P000001",
          "source_page": 1,
          "quote": "葬者乘生氣也"
        }
      },
      {
        "term": "龙",
        "plain_definition": "连续起伏的山脉走势。",
        "contextual_definition": "它是山势脉络的比喻，不是神话动物。",
        "tier": "core",
        "confidence": "qualified",
        "aliases": [
          "龍"
        ],
        "first_occurrence": {
          "block_id": "P000002-B003",
          "page_id": "P000002",
          "source_page": 2,
          "quote": "一端也且夫真龍降跡迢迢百里或數十里結為"
        },
        "usage_example": "例：“龙贵阴”中的龙，是连绵而来的山脉走势。",
        "related_terms": [
          "生气",
          "穴"
        ],
        "common_confusions": "易混：这里不是神话动物，而是山脉的连续走势。"
      },
      {
        "term": "支",
        "plain_definition": "平缓隐伏的地势支脉。",
        "contextual_definition": "本书常把它与高起明显的垄相对。",
        "tier": "core",
        "confidence": "qualified",
        "aliases": [
          "支"
        ],
        "first_occurrence": {
          "block_id": "P000004-B001",
          "page_id": "P000004",
          "source_page": 4,
          "quote": "壟之骨岡阜之支氣之所隨"
        },
        "usage_example": "例：“支葬其巅”说平缓支脉的穴位应取其微微隆起处。",
        "related_terms": [
          "生气",
          "穴"
        ],
        "common_confusions": "易混：支脉较平缓隐伏，不等于任意一块平地。"
      },
      {
        "term": "垄",
        "plain_definition": "高起明显的山脊走势。",
        "contextual_definition": "本书常把它与平缓隐伏的支相对。",
        "tier": "core",
        "confidence": "qualified",
        "aliases": [
          "壠"
        ],
        "first_occurrence": {
          "block_id": "P000004-B002",
          "page_id": "P000004",
          "source_page": 4,
          "quote": "中之綱領也丘壠爲陰岡阜爲陽丘言其高骨乃"
        },
        "usage_example": "例：“垄葬其麓”说高起山脊的穴位应取其落势会合处。",
        "related_terms": [
          "生气",
          "穴"
        ],
        "common_confusions": "易混：垄指高起明显的山脊，不是田垄。"
      },
      {
        "term": "穴",
        "plain_definition": "传统上认为气聚的安葬点。",
        "contextual_definition": "它必须结合来势、停处、四周护卫和深浅共同判断。",
        "tier": "core",
        "confidence": "qualified",
        "aliases": [
          "穴"
        ],
        "first_occurrence": {
          "block_id": "P000002-B003",
          "page_id": "P000002",
          "source_page": 2,
          "quote": "數十里結為一穴及至穴所則羣峰矗矗呈秀於"
